[Desktop Entry]
Type=Application
Version=0.1.0
Name=Ultrapkg Plus
Comment=XFCE package store for APT, Flatpak, and AppImage workflows
Exec=ultrapkg-plus %F
Icon=ultrapkg-plus
Terminal=false
Categories=System;PackageManager;Utility;Settings;
MimeType=application/vnd.debian.binary-package;application/x-deb;application/x-appimage;application/x-iso9660-appimage;application/vnd.flatpak.ref;application/vnd.flatpak.repo;application/x-sharedlib;application/vnd.debian.binary-package;
StartupNotify=true
Keywords=package;install;flatpak;apt;appimage;xfce;store;
